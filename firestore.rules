rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profils : accessibles seulement à qui connaît la clé secrète (22 caractères). Pas de listing.
    match /users/{uid} {
      allow get, create, update: if uid.size() >= 16;
      allow list, delete: if false;
    }
    // Duos : accessibles seulement à qui connaît le code (10 caractères). Pas de listing des duos.
    match /duos/{code} {
      allow get, create, update: if code.size() >= 10;
      allow list, delete: if false;
      match /{coll}/{rest=**} {
        allow read, write: if code.size() >= 10;
      }
    }
  }
}
